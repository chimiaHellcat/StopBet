<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StopBet"
             x:Class="StopBet.MainPage"
             Title="StopBet">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Dominios bloqueados (cache local)"
            FontSize="22"
            FontAttributes="Bold" />

        <HorizontalStackLayout Grid.Row="1" Spacing="15">
            <Label
                x:Name="ContadorLabel"
                Text="Carregando..."
                VerticalOptions="Center" />
            <Button
                x:Name="AtualizarBtn"
                Text="Atualizar"
                Clicked="OnAtualizarClicked" />
        </HorizontalStackLayout>

        <CollectionView
            Grid.Row="2"
            x:Name="DominiosCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ItemDominioExibicao">
                    <Grid Padding="0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Label
                            Grid.Row="0" Grid.Column="0"
                            Text="{Binding NomeDominio}"
                            FontAttributes="Bold" />
                        <Label
                            Grid.Row="1" Grid.Column="0"
                            Text="{Binding Categoria}"
                            FontSize="12"
                            TextColor="Gray" />
                        <Label
                            Grid.Row="2" Grid.Column="0"
                            Text="{Binding Ip, StringFormat='IP: {0}'}"
                            FontSize="12"
                            TextColor="Gray" />
                        <Label
                            Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                            Text="{Binding Origem}"
                            FontSize="12"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
